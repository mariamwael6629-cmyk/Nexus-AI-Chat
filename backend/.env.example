# Copy this file to .env and adjust values for your environment.

# SQLite by default. For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/nexus_ai
DATABASE_URL=sqlite:///./nexus.db

# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:3000,http://127.0.0.1:5500

ENVIRONMENT=development
